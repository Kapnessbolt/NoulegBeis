{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Microsoft_365__sharepoint_search",
      "mcp__Microsoft_365__sharepoint_folder_search",
      "mcp__Microsoft_365__outlook_email_search",
      "mcp__Microsoft_365__read_resource",
      "mcp__Microsoft-365__sharepoint_search",
      "mcp__Microsoft-365__sharepoint_folder_search",
      "mcp__Microsoft-365__outlook_email_search",
      "mcp__Microsoft-365__read_resource",
      "mcp__6501b655-9b79-4832-8016-17eddb19e4b6__sharepoint_search",
      "mcp__6501b655-9b79-4832-8016-17eddb19e4b6__sharepoint_folder_search",
      "mcp__6501b655-9b79-4832-8016-17eddb19e4b6__outlook_email_search",
      "mcp__6501b655-9b79-4832-8016-17eddb19e4b6__read_resource",
      "mcp__6501b655-9b79-4832-8016-17eddb19e4b6__outlook_calendar_search",
      "mcp__github__issue_read",
      "Bash(gh issue view:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git status:*)",
      "Bash(date:*)",
      "Bash(python3 .claude/scripts/controlla-vault.py:*)",
      "Bash(python3 .claude/scripts/rinomina-nota.py:*)",
      "Bash(python3 .claude/scripts/famiglia.py:*)",
      "Bash(python3 .claude/scripts/perimetro.py:*)",
      "Bash(python3 .claude/scripts/stato.py:*)",
      "Bash(python3 .claude/scripts/nuova-nota.py:*)",
      "Bash(python3 .claude/scripts/aggiorna-nota.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/controllo-pre-commit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          },
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config merge.stato.driver \"python3 .claude/scripts/stato.py merge-driver %O %A %B\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pull-inizio-sessione.sh",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/promemoria-fine-turno.sh"
          }
        ]
      }
    ]
  }
}
