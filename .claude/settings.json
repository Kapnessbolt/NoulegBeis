{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Microsoft_365__sharepoint_search",
      "mcp__Microsoft_365__sharepoint_folder_search",
      "mcp__Microsoft_365__outlook_email_search",
      "mcp__Microsoft_365__read_resource",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git status:*)",
      "Bash(date:*)",
      "Bash(python3 .claude/scripts/controlla-vault.py:*)",
      "Bash(python3 .claude/scripts/rinomina-nota.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/controllo-pre-commit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
